/* pages/result/result.wxss */

.container {
  padding: 20rpx 30rpx 60rpx;
  background: #F5F7FA;
  min-height: 100vh;
}

.header {
  padding: 20rpx 0;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1A2332;
}

.score-summary {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.score-box {
  flex: 1;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.score-box.strict .score-number {
  color: #E74C3C;
}

.score-box.warm .score-number {
  color: #2ECC71;
}

.score-label {
  display: block;
  font-size: 26rpx;
  color: #6B7A8F;
}

.score-number {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  margin: 8rpx 0;
}

.score-unit {
  display: block;
  font-size: 24rpx;
  color: #6B7A8F;
}

.feedback-section {
  margin-top: 24rpx;
}

.feedback-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A2332;
  margin-bottom: 12rpx;
}

.feedback-box {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 20rpx;
  border-left: 6rpx solid #4A6CF7;
}

.feedback-box.strict-bg {
  border-left-color: #E74C3C;
}

.feedback-box.warm-bg {
  border-left-color: #2ECC71;
}

.feedback-text {
  display: block;
  font-size: 28rpx;
  color: #1A2332;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

.btn-group {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.report-btn {
  background: linear-gradient(135deg, #4A6CF7, #6A4CF7);
  color: #FFFFFF;
  border: none;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 28rpx 0;
  width: 100%;
}

.back-btn {
  background: #E8ECF1;
  color: #1A2332;
  border: none;
  border-radius: 50rpx;
  font-size: 28rpx;
  padding: 24rpx 0;
  width: 100%;
}