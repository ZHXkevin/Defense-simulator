/* pages/index/index.wxss */

.container {
  padding: 20rpx 30rpx 60rpx;
  background: #F5F7FA;
  min-height: 100vh;
}

/* ===== 头部（新增历史记录入口） ===== */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 0 30rpx;
}

.header-left {
  flex: 1;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1A2332;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: #6B7A8F;
  margin-top: 8rpx;
}

/* ===== 历史记录入口按钮 ===== */
.history-link {
  padding: 12rpx 24rpx;
  background: #E8ECF1;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #1A2332;
  text-decoration: none;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.history-link:active {
  background: #d5d9e0;
}

/* ===== 恢复训练弹窗 ===== */
.resume-dialog {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.resume-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
}

.resume-content {
  position: relative;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 32rpx;
  width: 600rpx;
  text-align: center;
  animation: popIn 0.3s ease-out;
}

@keyframes popIn {
  0% { transform: scale(0.8); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.resume-icon {
  font-size: 64rpx;
}

.resume-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1A2332;
  margin-top: 16rpx;
}

.resume-info {
  display: block;
  font-size: 26rpx;
  color: #6B7A8F;
  margin-top: 12rpx;
}

.resume-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.resume-btn {
  flex: 1;
  padding: 20rpx 0;
  border: none;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.resume-btn.discard {
  background: #f5f5f5;
  color: #999;
}

.resume-btn.continue {
  background: #4A6CF7;
  color: #FFFFFF;
}

/* ===== 白色卡片区域 ===== */
.section {
  margin-top: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A2332;
  margin-bottom: 16rpx;
}

.picker {
  padding: 20rpx;
  background: #F5F7FA;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #1A2332;
}

.input {
  padding: 20rpx;
  background: #F5F7FA;
  border-radius: 10rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  background: #F5F7FA;
  border-radius: 10rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* ===== 上传区域 ===== */
.upload-status {
  padding: 16rpx 20rpx;
  background: #F0F4FF;
  border-radius: 10rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-text {
  font-size: 28rpx;
  color: #1A2332;
  flex: 1;
}

.status-size {
  font-size: 24rpx;
  color: #6B7A8F;
}

.upload-btn {
  width: 100%;
  padding: 20rpx 0;
  background: #E8ECF1;
  color: #1A2332;
  border: none;
  border-radius: 10rpx;
  font-size: 28rpx;
  text-align: center;
}

.upload-btn[disabled] {
  opacity: 0.6;
}

.content-preview {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #F5F7FA;
  border-radius: 10rpx;
}

.preview-label {
  display: block;
  font-size: 24rpx;
  color: #6B7A8F;
  margin-bottom: 8rpx;
}

.preview-text {
  display: block;
  font-size: 26rpx;
  color: #1A2332;
  line-height: 1.6;
}

/* ===== 生成按钮 ===== */
.primary-btn {
  margin-top: 40rpx;
  background: linear-gradient(135deg, #4A6CF7, #6A4CF7);
  color: #FFFFFF;
  border: none;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 28rpx 0;
  width: 100%;
}

.primary-btn[disabled] {
  opacity: 0.5;
}